# Adelaide Traffic Intelligence - Environment Configuration
# Copy this file to .env and fill in your actual values

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=8504

# Database Configuration (if needed in future)
# DATABASE_URL=sqlite:///traffic_data.db

# Model Configuration
MODEL_PATH=models/
MODEL_NAME=ridge_regression_model.pkl

# Logging
LOG_LEVEL=INFO

# Security Settings
SECRET_KEY=your_secret_key_here_change_in_production

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# External APIs
WEATHER_API_KEY=your_weather_api_key_if_needed
TRANSIT_API_KEY=your_transit_api_key_if_needed 